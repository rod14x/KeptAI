# Copiar a .env.production (ignorado por Git) y reemplazar todos los valores de ejemplo.
BACKEND_HTTP_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://DB_HOST:5432/postgres?currentSchema=keptai&sslmode=require
SPRING_DATASOURCE_USERNAME=RUNTIME_LOGIN_FROM_SUPABASE
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_RUNTIME_PASSWORD
KEPTAI_JWT_ISSUER_URI=https://PROJECT_REF.supabase.co/auth/v1
KEPTAI_JWT_JWK_SET_URI=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
KEPTAI_JWT_AUDIENCES=authenticated
KEPTAI_CORS_ALLOWED_ORIGINS=https://keptai.ejesxyz.com
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=keptai-vouchers
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_SECRET

# Valores ficticios; copiar a .env local y no commitear secretos reales.
PORT=8080
SPRING_PROFILES_ACTIVE=dev
# El archivo .env no se carga solo. scripts/run-local.sh lo importa en perfil local.
# JDBC local sigue en BD/local/.env, con rol runtime y sin copiar secretos.
# Solo prod (valores reales fuera del repo, en Render/CI). dev/test arrancan sin ellos.
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DB?sslmode=require
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# --- MIG-03-A: seguridad (valores publicos o de ejemplo; los reales van en el entorno, no en Git) ---
# JWT del panel (Supabase Auth). Los tres juntos o ninguno. Issuer y JWKS con https.
# KEPTAI_JWT_ISSUER_URI=https://<proyecto>.supabase.co/auth/v1
# KEPTAI_JWT_JWK_SET_URI=https://<proyecto>.supabase.co/auth/v1/.well-known/jwks.json
# KEPTAI_JWT_AUDIENCES=authenticated
# Origenes del navegador, exactos y separados por coma (perfil local ya admite http://localhost:5173).
# KEPTAI_CORS_ALLOWED_ORIGINS=https://app.ejemplo.invalid
# Webhook saliente a WF3: url y secreto (>= 32 caracteres) juntos. X-Api-Key de n8n NO va aqui: se guarda su hash en BD.
# KEPTAI_N8N_WEBHOOK_URL=https://n8n.ejemplo.invalid/webhook/enviar-mensaje
# KEPTAI_N8N_WEBHOOK_SECRET=

# MIG-04/05: cliente Storage implementado; secreto solo en el entorno del backend.
# No es la password PostgreSQL ni un JWT de usuario. Nunca usar en VITE_*.
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_STORAGE_BUCKET=keptai-vouchers
# SUPABASE_SECRET_KEY=

    {
      "parameters": {
        "jsCode": "\nconst b = $('Webhook Evolution').first().json.body || {};\nconst ev = String(b.event || '').toLowerCase().replace('_', '.');\nconst d = b.data || {};\nconst key = d.key || {};\nconst jid = key.remoteJid || '';\nconst msg = d.message || {};\nconst text = (msg.conversation || msg.extendedTextMessage?.text || msg.imageMessage?.caption || '').trim();\nconst out = {\n  route: 'ignorar', instance: b.instance, remoteJid: jid, fromMe: !!key.fromMe, messageId: key.id,\n  messageType: d.messageType, pushName: d.pushName || '', text,\n  vendedorJid: b.sender || '', ts: d.messageTimestamp || null,\n};\nif (ev === 'messages.upsert' && jid && !jid.endsWith('@g.us') && jid !== 'status@broadcast') {\n  const low = text.toLowerCase();\n  if (out.fromMe && low.startsWith('/cerrar')) out.route = 'cerrar';\n  else if (out.fromMe && low.startsWith('/ok')) { out.route = 'confirmar'; out.ref = text.split(/\\s+/)[1] || ''; }\n  else if (!out.fromMe && d.messageType === 'imageMessage') out.route = 'voucher';\n}\nreturn [{ json: out }];\n"
      },

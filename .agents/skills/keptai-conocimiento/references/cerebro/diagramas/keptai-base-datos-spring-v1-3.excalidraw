  {
   "id": "inv-t",
   "type": "text",
   "x": 724.04,
   "y": 1138.75,
   "width": 1011.9200000000001,
   "height": 122.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",

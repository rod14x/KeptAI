      "id": "4f8ab6d6-ec68-40a4-9025-205634dfc684",
      "name": "Evolution findMessages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst r = $json;\nlet recs = r?.messages?.records ?? r?.records ?? r?.messages ?? (Array.isArray(r) ? r : []);\nif (!Array.isArray(recs)) recs = [];\nconst out = [];\nfor (const m of recs) {\n  const msg = m.message || {};\n  const type = m.messageType || Object.keys(msg)[0] || '';\n  let text = msg.conversation || msg.extendedTextMessage?.text || '';\n  let media = null, mimetype = null, caption = '';\n  if (type === 'imageMessage' || msg.imageMessage) { media = 'image'; mimetype = msg.imageMessage?.mimetype || 'image/jpeg'; caption = msg.imageMessage?.caption || ''; }\n  else if (type === 'audioMessage' || msg.audioMessage) { media = 'audio'; mimetype = msg.audioMessage?.mimetype || 'audio/ogg'; }\n  else if (type === 'documentMessage' || msg.documentMessage) { text = '[DOCUMENTO] ' + (msg.documentMessage?.fileName || ''); }\n  else if (type === 'videoMessage' || msg.videoMessage) { text = '[VIDEO]'; }\n  else if (type === 'stickerMessage' || msg.stickerMessage) { continue; }\n  if (!text && !media) continue;\n  out.push({ json: { id: m.key?.id, fromMe: !!m.key?.fromMe, ts: Number(m.messageTimestamp || 0), text, mediaType: media, mimetype, caption } });\n}\nout.sort((a, b) => a.json.ts - b.json.ts);\nreturn out.slice(-400);\n"
      },

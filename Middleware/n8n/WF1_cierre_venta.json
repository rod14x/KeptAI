      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.evoUrl }}/chat/findMessages/{{ $('Webhook venta-cerrar').first().json.body.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.evoKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ where: { key: { remoteJid: $('Webhook venta-cerrar').first().json.body.remoteJid } } }) }}",
        "options": {}

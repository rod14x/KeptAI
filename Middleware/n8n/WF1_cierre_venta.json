      "id": "c922341c-27d2-4bf5-8a5b-a4f39288e1ae",
      "name": "LLM extraer pedido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2780,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst prev = $('Preparar LLM').first().json;\nlet raw = $json.choices?.[0]?.message?.content || '{}';\nraw = raw.replace(/^```json\\s*|```$/g, '').trim();\nlet ex; try { ex = JSON.parse(raw); } catch (e) { ex = { error_parseo: String(e), crudo: raw.slice(0, 500), faltantes: ['No se pudo interpretar el chat'], confianza: 0 }; }\nconst money = n => (n == null ? '—' : 'S/ ' + Number(n).toFixed(2));\nconst items = (ex.items || []).map(i => `| ${i.descripcion || ''} | ${i.cantidad ?? '—'} | ${i.tela || '—'} | ${i.detalle_tallas || '—'} | ${i.logo_diseno || '—'} | ${money(i.precio_unitario)} |`).join('\\n');\nconst cp = ex.condicion_pago || {};\nconst md = `# Hoja de resumen del pedido\n**Cliente:** ${ex.cliente?.nombre || '—'} (${ex.cliente?.ruc || 'sin RUC'})\n**Marca:** ${ex.marca || '—'}\n**Entrega solicitada:** ${ex.fecha_entrega_solicitada || '—'}\n**Condición de pago:** ${cp.tipo || '—'}${cp.plazo_dias ? ' a ' + cp.plazo_dias + ' días' : ''}${cp.anticipo_monto ? ' · anticipo ' + money(cp.anticipo_monto) : ''}\n**Total:** ${money(ex.total)}\n\n| Descripción | Cant. | Tela | Tallas | Logo/diseño | P. unit. |\n|---|---|---|---|---|---|\n${items}\n\n**Observaciones:** ${ex.observaciones || '—'}\n**Faltantes por confirmar:** ${(ex.faltantes || []).join('; ') || 'ninguno'}\n**Confianza de la lectura:** ${ex.confianza ?? '—'}`;\nreturn [{ json: { origen: 'whatsapp', instancia: prev.instance, chatId: prev.remoteJid, vendedorJid: prev.vendedorJid,\n  clienteNombreChat: prev.pushName, extraccion: ex, hojaResumenMd: md, transcript: prev.transcript,\n  mensajesProcesados: prev.mensajes, generadoEn: new Date().toISOString() } }];\n"
      },
      "id": "3e76812e-3aa1-4672-b733-f617595ffec2",
      "name": "Parsear y hoja resumen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3000,
        0
      ]
    },

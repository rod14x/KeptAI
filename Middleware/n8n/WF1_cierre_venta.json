              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.llmKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Config').first().json.visionModel, temperature: 0, messages: [{ role: 'user', content: [{ type: 'text', text: 'Describe en español lo relevante para un pedido de confección: logos, diseños, colores, medidas, nombres, cantidades, montos y texto literal visible. Si es un comprobante de pago (Yape, Plin, transferencia) indica banco, monto, fecha y código de operación. Máximo 120 palabras.' }, { type: 'image_url', image_url: { url: 'data:' + ($json.mimetype || 'image/jpeg') + ';base64,' + $json.base64 } }] }] }) }}",
        "options": {}
      },
      "id": "c3b39ade-1ee7-4cc5-bcd1-666e40b49554",
      "name": "Describir imagen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1400,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst src = $('Media lista').item.json;\nconst desc = $json.choices?.[0]?.message?.content || '';\nconst cap = src.caption ? ' (pie: ' + src.caption + ')' : '';\nreturn { json: { id: src.id, ts: src.ts, fromMe: src.fromMe, text: '[IMAGEN]' + cap + ' ' + desc } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "07670b11-f7fd-43e9-a21a-ecf269335072",
      "name": "Texto imagen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        40
      ]
    },
    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "3aa43155-b882-4d4f-9bcf-6ab1f4ce2a8e",
      "name": "Unir mensajes",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.1,
      "position": [
        2120,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $('Webhook venta-cerrar').first().json.body || {};\nconst items = $input.all().map(i => i.json).sort((a, b) => a.ts - b.ts);\nconst fmt = ts => new Date(ts * 1000).toLocaleString('es-PE', { timeZone: 'America/Lima', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false });\nlet transcript = items.map(m => `[${fmt(m.ts)}] ${m.fromMe ? 'VENDEDOR' : 'CLIENTE'}: ${m.text}`).join('\\n');\nif (transcript.length > 60000) transcript = transcript.slice(-60000);\nreturn [{ json: { transcript, mensajes: items.length, instance: body.instance, remoteJid: body.remoteJid, vendedorJid: body.vendedorJid, pushName: body.pushName || '' } }];\n"
      },
      "id": "9453b957-faff-4b2e-8478-5ad96910520a",
      "name": "Armar transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2340,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst hoy = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Lima' });\nconst system = `Eres analista comercial de una confeccionista peruana con marcas CORPOTEX (uniformes corporativos e industriales), UNICRACK SPORT (ropa deportiva) y UNICRACK UNIFORMES (escolares).\nRecibes la transcripción completa de un chat de venta por WhatsApp (puede incluir audios transcritos e imágenes descritas).\nDevuelve SOLO un JSON válido con esta forma exacta:\n{\"cliente\":{\"nombre\":string|null,\"ruc\":string|null,\"tipo\":\"PERSONA\"|\"EMPRESA\"|null},\n \"marca\":\"CORPOTEX\"|\"UNICRACK_SPORT\"|\"UNICRACK_UNIFORMES\"|null,\n \"items\":[{\"descripcion\":string,\"cantidad\":number|null,\"unidad\":string|null,\"detalle_tallas\":string|null,\"tela\":string|null,\"logo_diseno\":string|null,\"precio_unitario\":number|null}],\n \"total\":number|null,\"moneda\":\"PEN\",\n \"condicion_pago\":{\"tipo\":\"CONTADO\"|\"CREDITO\"|\"ANTICIPO\"|\"NO_DEFINIDA\",\"plazo_dias\":number|null,\"anticipo_monto\":number|null,\"anticipo_pct\":number|null},\n \"fecha_entrega_solicitada\":\"YYYY-MM-DD\"|null,\n \"pagos_mencionados\":[{\"monto\":number|null,\"fecha\":\"YYYY-MM-DD\"|null,\"medio\":string|null,\"nota\":string|null}],\n \"observaciones\":string,\"faltantes\":[string],\"confianza\":number}\nReglas: NO inventes datos; si algo no está en el chat usa null y agrégalo a \"faltantes\". Usa el último acuerdo del chat si hubo cambios. Hoy es ${hoy} (zona Lima): resuelve fechas relativas desde hoy. Los montos son números sin símbolo.`;\nconst body = { model: cfg.llmModel, temperature: 0, response_format: { type: 'json_object' },\n  messages: [{ role: 'system', content: system }, { role: 'user', content: $json.transcript }] };\nreturn [{ json: { ...$json, llmBody: body } }];\n"
      },
      "id": "44740162-6423-4cbf-9f6e-4b448353533b",
      "name": "Preparar LLM",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2560,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.llmUrl }}/chat/completions",

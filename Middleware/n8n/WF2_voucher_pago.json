      "id": "b38edd08-c44f-4a72-9e90-fa8d74909c5f",
      "name": "Evolution base64 imagen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst b64 = $json.base64 ?? $json.data?.base64 ?? '';\nconst mime = $json.mimetype ?? $json.data?.mimetype ?? 'image/jpeg';\nconst prompt = `Lee este comprobante de pago peruano (Yape, Plin, transferencia bancaria, depósito) y devuelve SOLO un JSON válido:\n{\"es_voucher\":boolean,\"tipo\":\"YAPE\"|\"PLIN\"|\"TRANSFERENCIA\"|\"DEPOSITO\"|\"OTRO\"|null,\"banco\":string|null,\"monto\":number|null,\"moneda\":\"PEN\"|\"USD\"|null,\n\"fecha\":\"YYYY-MM-DD\"|null,\"hora\":\"HH:MM\"|null,\"codigo_operacion\":string|null,\"remitente\":string|null,\"destinatario\":string|null,\"confianza\":number}\nNo inventes: si un dato no se ve, usa null. Si la imagen NO es un comprobante, es_voucher=false.`;\nconst body = { model: cfg.visionModel, temperature: 0, response_format: { type: 'json_object' },\n  messages: [{ role: 'user', content: [{ type: 'text', text: prompt }, { type: 'image_url', image_url: { url: `data:${mime};base64,${b64}` } }] }] };\nreturn [{ json: { llmBody: body } }];\n"
      },
      "id": "d3cc3bbf-0143-45f4-a70e-985c21b09d56",
      "name": "Preparar visión",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.llmUrl }}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.llmKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.llmBody) }}",
        "options": {}
      },
      "id": "5ad72a0c-50aa-40c7-90e6-c487cae8b21f",
      "name": "LLM leer voucher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst b = $('Webhook voucher').first().json.body || {};\nlet raw = $json.choices?.[0]?.message?.content || '{}';\nraw = raw.replace(/^```json\\s*|```$/g, '').trim();\nlet ex; try { ex = JSON.parse(raw); } catch (e) { ex = { es_voucher: false, confianza: 0, error_parseo: String(e) }; }\nreturn [{ json: { instancia: b.instance, chatId: b.remoteJid, clienteJid: b.remoteJid, mensajeId: b.messageId,\n  pushName: b.pushName || '', recibidoEn: new Date().toISOString(), extraccion: ex } }];\n"
      },
      "id": "0747bad5-af66-44db-9cdd-2306e2741ee8",
      "name": "Parsear voucher",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

    {
      "parameters": {
        "jsCode": "\nconst m = $('Normalizar mensaje').first().json;\nconst ok = Number($json.statusCode) >= 200 && Number($json.statusCode) < 300;\nreturn [{ json: { mensajeId: m.mensajeId, ordenId: m.ordenId, tipo: m.tipo, idempotencyKey: m.idempotencyKey,\n  estado: ok ? 'ENVIADO' : 'ERROR', providerMessageId: ok ? ($json.body?.key?.id || null) : null,\n  error: ok ? null : JSON.stringify($json.body || $json.statusMessage || 'sin respuesta').slice(0, 400), enviadoEn: new Date().toISOString() } }];\n"
      },

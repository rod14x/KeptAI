    {
      "parameters": {
        "jsCode": "\nconst b = $('Webhook enviar-mensaje').first().json.body || {};\nlet num = String(b.numero || '').replace(/\\D/g, '');\nif (num.length === 9) num = '51' + num;            // celular peruano sin código de país\nconst texto = String(b.texto || '').trim();\nconst base = Number(b.delayMs ?? 0);\nconst delayMs = base > 0 ? base : 2500 + Math.floor(Math.random() * 6000);   // 2.5 a 8.5 s: evita ráfagas\nconst valido = num.length >= 11 && texto.length > 0 && !!b.instance;\nreturn [{ json: { valido, instance: b.instance, numero: num, texto, delayMs, delaySeg: Math.max(1, Math.round(delayMs / 1000)),\n  mensajeId: b.mensajeId || null, tipo: b.tipo || null, ordenId: b.ordenId || null, idempotencyKey: b.idempotencyKey || null } }];\n"
      },
      "id": "e803ae82-b233-4fe7-8763-72c789463c27",
      "name": "Normalizar mensaje",

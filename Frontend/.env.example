# Todas las variables VITE_ son públicas. Nunca poner claves privadas aquí.

# Fuente de datos: "mock" (semilla local de demostración) o "api" (Spring + Supabase Auth).
VITE_API_MODE=mock

# Solo para VITE_API_MODE=api
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

VITE_APP_ENV=demo
